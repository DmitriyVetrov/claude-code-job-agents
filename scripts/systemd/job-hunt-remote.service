# Claude Code Remote Control for job-hunt: the "Job Hunt" item in the Claude app on the
# phone, from which you start sessions that run here on the laptop.
# Install (adjust the paths if the repo is not in ~/Documents/job-hunt):
#   ln -s ~/Documents/job-hunt/scripts/systemd/job-hunt-remote.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now job-hunt-remote
# Logs: journalctl --user -u job-hunt-remote -f
#
# Bound to the graphical session like job-hunt-bot: remote sessions drive Playwright's
# Chrome, which needs the desktop. A locked screen is fine.

[Unit]
Description=job-hunt: Claude Code Remote Control (access from the phone)
PartOf=graphical-session.target
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/job-hunt
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TERM=xterm-256color
# remote-control is an interactive TUI and needs a terminal: script provides a pty
ExecStart=/usr/bin/script -qfec "claude remote-control --name 'Job Hunt'" /dev/null
Restart=always
RestartSec=15

[Install]
WantedBy=graphical-session.target
