# Copy to .env (repo root) and fill in. .env is gitignored.

# Telegram notifications for /hunt (scripts/tg_notify.py)
# 1. In Telegram: @BotFather -> /newbot -> paste the token below.
# 2. Send /start to your bot, then run:
#      python3 scripts/tg_notify.py --find-chat-id --save
#    It fills in TELEGRAM_CHAT_ID for you.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram bot schedule (scripts/tg_bot.py): <days> <HH:MM> <hunt args>, or off.
# Without "apply" the run is report-only and the MATCH jobs come as buttons; with
# "apply" it applies to every MATCH by itself. Change from the phone with /schedule.
HUNT_SCHEDULE=Mon-Fri 04:00 daily apply
