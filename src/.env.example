# Copy to src/.env and fill in the values (or set the variables in your
# environment).

# Anthropic API key — the same one you use for Claude Code.
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# The Claude model for all agents. Can be swapped for a newer one
# (for example claude-sonnet-5, claude-opus-4-8).
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5-20250929

# Optional: your own endpoint (Foundry-compatible, etc.)
# ANTHROPIC_BASE_URL=https://your-custom-endpoint.com
